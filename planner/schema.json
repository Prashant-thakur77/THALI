{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Thali skill plan",
  "type": "object",
  "required": ["steps"],
  "additionalProperties": false,
  "properties": {
    "instruction": {"type": "string"},
    "mode": {"type": "string", "enum": ["normal", "gentle"], "default": "normal"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["skill", "arm"],
        "additionalProperties": false,
        "properties": {
          "skill": {"type": "string", "enum": ["open_drawer", "pick_place", "handoff", "hold_mug", "pour", "place_mug"]},
          "arm": {"type": "string", "enum": ["a", "b"]},
          "obj": {"type": ["string", "null"], "enum": ["plate", "mug", "bottle", "fork_1", "fork_2", "spoon_1", "spoon_2", null]},
          "zone": {"type": ["string", "null"], "enum": ["plate", "fork", "spoon", "mug", null]},
          "to_arm": {"type": ["string", "null"], "enum": ["a", "b", null]},
          "amount": {"type": ["string", "null"], "enum": ["little", "normal", "full", null]}
        }
      }
    }
  }
}
